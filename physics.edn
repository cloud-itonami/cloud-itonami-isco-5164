;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a grooming-support robot performs supply
;; setup, coat brushing and cleanup alongside a supervising groomer.
;; Declared here: cleanup -- draining the bathing tub between animals --
;; and supply setup -- a full shampoo / conditioner jug lifted from the floor
;; store onto the tub-side shelf.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-5164"
 :cases
 [{:id :bathing-tub-drain
   :kind :tank-drain
   :procedure "robot pulls the plug of the grooming bathing tub after a bath; the tub must be down to 1 cm before the next animal"
   :params {:tank-area-m2 0.55 :h0-m 0.20 :h-target-m 0.01 :cd 0.62 :q-in-m3s 0.0 :dt-s 0.1}
   :sweep {:param :orifice-area-m2 :values [0.0002 0.0004 0.0007 0.0011 0.0016]}
   :quantity :time-to-target-s
   :limit {:max 120.0 :basis "estimate: the tub empties while the groomer towels the previous animal (~2 minutes)"}
   :boundary {:lo 0.0001 :hi 0.003}}
  {:id :shampoo-jug-to-shelf
   :kind :manipulator
   :procedure "arm lifts a full shampoo jug from the floor store onto the tub-side shelf"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 4.5 :m2-kg 3.0
            :from [0.45 -0.45] :to [0.40 0.40] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [1.0 2.5 5.0 10.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 80.0 :basis "estimate: continuous shoulder torque of a ~8 kg-payload collaborative arm"}
   :boundary {:lo 0.2 :hi 40.0}}]}
